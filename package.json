{
  "name": "@horizen/vela-common-ts",
  "version": "0.3.0",
  "description": "TypeScript library for interacting with Vela smart contracts. Provides P-521 ECDH encryption and blockchain client for browser applications.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "default": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js",
        "default": "./dist/node.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "rm -rf dist",
    "build":"npm run build:bundle && npm run build:node && npm run build:types",
    "build:bundle": "esbuild src/index.ts --bundle --platform=browser --format=esm --target=es2020 --outdir=dist --sourcemap",
    "build:node": "esbuild src/node.ts --bundle --platform=node --format=esm --target=es2020 --packages=external --outfile=dist/node.js --sourcemap",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --outDir dist",
    "check": "tsc --noEmit",
    "test": "node --experimental-global-webcrypto --import tsx node_modules/.bin/mocha 'src/**/*.spec.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HorizenOfficial/vela-common-ts.git"
  },
  "keywords": [
    "vela",
    "ecdh",
    "p521",
    "encryption",
    "blockchain",
    "ethereum",
    "web3"
  ],
  "author": "Horizen",
  "peerDependencies": {
    "ethers": "^6.0.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/chai": "^5.2.3",
    "@types/elliptic": "^6.4.18",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "esbuild": "^0.27.7",
    "ethers": "^6.16.0",
    "hardhat": "^3.1.5",
    "mocha": "^11.7.5",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.0",
    "axios": "^1.13.2",
    "elliptic": "^6.6.1"
  }
}
